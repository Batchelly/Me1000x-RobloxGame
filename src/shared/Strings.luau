-- "pt-br" / "pt-pt" -> "pt"; qualquer outra coisa -> "en"
function Strings.langFor(localeId: string?): string
	if type(localeId) == "string" and string.sub(string.lower(localeId), 1, 2) == "pt" then
		return "pt"
	end
	return "en"
end

function Strings.get(lang: string, key: string, args: { [string]: any }?): string
	local tableForLang = Strings[lang] or Strings.pt
	local text = tableForLang[key] or Strings.pt[key] or key
	if args then
		text = string.gsub(text, "{(%w+)}", function(name)
			local value = args[name]
			if value == nil then
				return "{" .. name .. "}"
			end
			return tostring(value)
		end)
	end
	return text
end

return Strings
